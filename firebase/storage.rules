rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /teacherLessonPackages/{teacherUID}/{lessonID}/versions/{versionID}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == teacherUID;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
