{
  "schemaVersion": 2,
  "widgetId": "graph-the-inequality-number-line-level-1",
  "activity": "multipleChoice",
  "title": "Graph the Inequality",
  "description": "Graph one-variable inequalities on a number line.",
  "learningObjective": "Students graph one-variable inequalities using open and closed endpoints with rays.",
  "difficulty": "easy",
  "presentation": {
    "preferredTheme": "cleanClassroom",
    "preferredExperience": "paperQuiz"
  },
  "rules": {
    "scoreMode": "correctOutOfAttempted",
    "advanceMode": "manual",
    "allowRetry": true,
    "shuffleQuestions": false,
    "shuffleChoices": false,
    "maxAttemptsPerQuestion": 2,
    "calculatorAllowed": false
  },
  "feedback": {
    "defaultCorrect": "Correct. Your graph matches the solution set.",
    "defaultIncorrect": "Not yet. Check the endpoint and the direction of the ray.",
    "defaultEncouragement": "Graph the inequality on the number line."
  },
  "questions": [
    {
      "id": "q1",
      "prompt": "Graph the following inequality.",
      "expression": "x \\le -3",
      "interactiveParts": [
        {
          "type": "numberLine",
          "id": "solution-q1",
          "domain": { "min": -8, "max": 4, "step": 1 },
          "features": {
            "pointsTappable": true,
            "pointsDraggable": true,
            "raysEnabled": true,
            "openClosedEndpoints": true,
            "pointHasRay": true,
            "maxPoints": 1,
            "labelsVisible": true,
            "snapToTicks": true
          },
          "answer": "linearGraphUtility{x<=-3}"
        }
      ],
      "choices": [
        { "id": "done", "label": "Done", "isCorrect": true },
        { "id": "check", "label": "I need to revise my graph", "isCorrect": false }
      ],
      "hints": [
        "Use a closed endpoint for \\le.",
        "Values less than -3 are to the left."
      ],
      "correctFeedback": "The selected answer is correct. The graph score checks the number line.",
      "incorrectFeedback": "Revise your graph before checking again."
    },
    {
      "id": "q2",
      "prompt": "Graph the following inequality.",
      "expression": "x > 4",
      "interactiveParts": [
        {
          "type": "numberLine",
          "id": "solution-q2",
          "domain": { "min": -2, "max": 10, "step": 1 },
          "features": {
            "pointsTappable": true,
            "pointsDraggable": true,
            "raysEnabled": true,
            "openClosedEndpoints": true,
            "pointHasRay": true,
            "maxPoints": 1,
            "labelsVisible": true,
            "snapToTicks": true
          },
          "answer": "linearGraphUtility{x>4}"
        }
      ],
      "choices": [
        { "id": "done", "label": "Done", "isCorrect": true },
        { "id": "check", "label": "I need to revise my graph", "isCorrect": false }
      ],
      "hints": [
        "Use an open endpoint for >.",
        "Values greater than 4 are to the right."
      ],
      "correctFeedback": "The selected answer is correct. The graph score checks the number line.",
      "incorrectFeedback": "Revise your graph before checking again."
    }
  ]
}
